# ccday 示例配置文件
# 复制到 ~/.ccday.conf 后按需修改
#
# cp ccday.conf.example ~/.ccday.conf

# ── 天气 ──────────────────────────────────────────────────────────────────────
# 和风天气 API（可选，不填自动用 open-meteo 免费天气）
# 申请地址: https://console.qweather.com
QWEATHER_API_HOST=xxxxxx.re.qweatherapi.com
QWEATHER_KID=你的凭据ID
QWEATHER_PROJECT_ID=你的项目ID
QWEATHER_PRIVATE_KEY=~/.ccday-private.pem
# 经纬度（open-meteo 和 QWeather 都用此项）
# 查询经纬度: https://www.latlong.net
QWEATHER_LOCATION=121.47,31.23   # 上海

# ── 出发地（用于计算旅行距离 + 周末出行灵感）──────────────────────────────────
# 🎒 周末灵感会按此坐标找最近的城市圈，给出具体目的地和车程
# 支持：上海/北京/广州/深圳/杭州/成都/武汉/西安/南京/重庆
# 离以上城市都超过 400km 时，只显示通用的近郊建议
HOME_LAT=31.28
HOME_LNG=121.52   # 上海杨浦

# ── 旅行计划（可选，设置后第二行显示距离和注意事项）──────────────────────────
# TRIP_NAME=长兴岛郊野公园
# TRIP_LAT=31.38
# TRIP_LNG=121.72
# TRIP_DATE=2026-05-01          # 出发日期，过期后自动隐藏
# TRIP_TIPS="带防晒霜;穿舒适的鞋;早点出发避开堵车;带足够的水;备好防虫喷雾"
# 多条 tip 用分号分隔，每天轮换一条显示

# ── Tip / 段子刷新频率 ────────────────────────────────────────────────────────
CCDAY_AI_JOKE=1           # 启用 AI 生成段子（需要 claude CLI，0 关闭）
CCDAY_TIP_ROTATE=5        # 每 N 次会话随机换一条 tip（默认 5）
CCDAY_AI_JOKE_ROTATE=20   # 每 N 次会话用 AI 生成新段子（默认 20）

# ── 上下班时间（下班倒计时 + 周末倒计时）─────────────────────────────────────
CCDAY_OFFWORK=1           # 1=显示下班倒计时 🕔，0=隐藏
# 仅工作日显示（自动跳过周末、法定节假日，识别调休上班日）

# 弹性工作制（默认开启）：打卡窗口内第一次用户活动记为上班时间，
# 下班点 = 上班 + CCDAY_WORK_HOURS。晚到晚走，不按死的 10:00 算。
# macOS 用 pmset -g log 取当天真实的首次用户活动（显示器点亮/HID 活动），
#   早上先开邮件、晚点才开 Claude Code 也不会把上班时间记晚；
#   后台进程断言和 DarkWake 不算（机器自己醒来收邮件不等于人到了）
# 其他平台或 pmset 取不到 → 退回状态栏在窗口内的首次刷新时刻
CCDAY_WORK_PUNCH=1        # 1=按首次用户活动打卡（默认），0=用固定 WORK_START/END
CCDAY_WORK_HOURS=9        # 打卡模式工时（默认 9 小时）
CCDAY_PUNCH_START=06:00   # 打卡有效窗口开始（默认 06:00）
CCDAY_PUNCH_END=12:00     # 打卡有效窗口结束（默认 12:00）
CCDAY_PUNCH_SHOW=1        # 1=倒计时带上 (10:22→19:22)，0=只显示剩余时间
# 首次活动晚于窗口（下午才开电脑）→ 退回下面的固定时间
# 打卡记录在 ~/.ccday-punch.json，只对当天有效；改错了删掉重开屏即可

# 固定上下班时间（CCDAY_WORK_PUNCH=0 或当天未打卡时生效）
CCDAY_WORK_START=10:00    # 上班时间（默认 10:00）
CCDAY_WORK_END=19:30      # 下班时间（默认 19:30）
# 支持跨天班，如 CCDAY_WORK_START=22:00 / CCDAY_WORK_END=06:00（跨天班自动禁用打卡）

# ── 今日目标（可选，状态栏显示 🎯 目标名）────────────────────────────────────
# CCDAY_GOAL=完成登录模块

# ── 休息提醒 ──────────────────────────────────────────────────────────────────
CCDAY_BREAK_INTERVAL=50   # 每隔 N 分钟提醒休息（默认 50）
CCDAY_BREAK_DURATION=10   # 休息时长 N 分钟（默认 10，仅 CONFIRM=1 时有效）
CCDAY_BREAK_HOLD=30       # 久坐全屏提醒强制停留秒数（默认 30，0=可立即关闭）
CCDAY_BREAK_CONFIRM=1     # 1=需要主动确认休息（有倒计时），0=定时自动消失
CCDAY_BREAK_START=09:00   # 提醒生效开始时间（默认 09:00）
CCDAY_BREAK_END=22:00     # 提醒生效结束时间（默认 22:00）
CCDAY_WATER_INTERVAL=60   # 每隔 N 分钟提醒喝水（默认 60，设 0 关闭）

# ── 饭点提醒 ──────────────────────────────────────────────────────────────────
CCDAY_LUNCH=12:00         # 午饭提醒时间（默认 12:00，留空关闭）
CCDAY_DINNER=18:00        # 晚饭提醒时间（默认 18:00，留空关闭）
CCDAY_MEAL_WINDOW=30      # 到点后持续显示 N 分钟自动消失（默认 30）

# ── 用量/余额插件 ─────────────────────────────────────────────────────────────
# 有即用，没有不用：token 和接口地址都探测不到时自动静默，不需要手动关。
# token 探测顺序: CCDAY_BILLING_TOKEN → 环境变量 ANTHROPIC_AUTH_TOKEN /
#   AICODING_API_KEY / ANTHROPIC_API_KEY → ~/.claude/settings.json 的 env 段 →
#   ~/.claude/live-code.json
# 接口地址默认取 $ANTHROPIC_BASE_URL + /v1/billing/usage
# 诊断: bash ~/.claude/scripts/ccday/ccday-billing.sh --check
CCDAY_BILLING=1             # 1=启用 💰 用量（默认），0=关闭
# CCDAY_BILLING_TOKEN=      # 显式指定 token，留空自动探测
# CCDAY_BILLING_API=        # 完整接口地址，留空按 ANTHROPIC_BASE_URL 推导
CCDAY_BILLING_BUDGET=0      # 每日预算（元），0=用接口返回的 daily_limit
CCDAY_BILLING_FORMAT=auto   # auto=💰余213¥ / percent=💰47% / used=💰用187¥
                            # balance=💰余额973¥ / full=💰187/400¥·47%
CCDAY_BILLING_POOL=0        # 1=额外显示团队池占用 🏊46%
CCDAY_BILLING_TTL=300       # 成功结果缓存秒数（默认 300）
CCDAY_BILLING_FAIL_TTL=1800 # 请求失败后静默秒数（默认 1800），避免反复打不通的接口
# 用量达预算 75% 显示 🔥，90% 显示 🈵
